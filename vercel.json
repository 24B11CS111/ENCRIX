                                        },
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(), microphone=(), geolocation=(), payment=()"
                                        },
                                        {
                                            "key":  "Strict-Transport-Security",
                                            "value":  "max-age=63072000; includeSubDomains; preload"
                                        },
                                        {
                                            "key":  "Content-Security-Policy",
                                            "value":  "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027 https:; style-src \u0027self\u0027 \u0027unsafe-inline\u0027 https:; img-src \u0027self\u0027 data: https:; font-src \u0027self\u0027 data: https:; connect-src \u0027self\u0027 https: wss:; frame-src \u0027self\u0027 https://*.razorpay.com; media-src \u0027self\u0027 https: blob:; object-src \u0027none\u0027; base-uri \u0027self\u0027; form-action \u0027self\u0027; frame-ancestors \u0027none\u0027;"
                                        }
