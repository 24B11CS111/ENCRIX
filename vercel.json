{
    "routes": [
        {
            "src": "/api/health",
            "dest": "/api/monitor",
            "transforms": [
                { "type": "request.query", "op": "set", "target": { "key": "__encrix_route" }, "args": "health" }
            ]
        },
        {
            "src": "/api/realtime/refresh",
            "dest": "/api/monitor",
            "transforms": [
                { "type": "request.query", "op": "set", "target": { "key": "__encrix_route" }, "args": "realtime-refresh" }
            ]
        },
        {
            "src": "/api/metrics",
            "dest": "/api/workspace",
            "transforms": [
                { "type": "request.query", "op": "set", "target": { "key": "__encrix_route" }, "args": "metrics" }
            ]
        },
        {
            "src": "/api/notifications",
            "dest": "/api/workspace",
            "transforms": [
                { "type": "request.query", "op": "set", "target": { "key": "__encrix_route" }, "args": "notifications" }
            ]
        }
    ],
