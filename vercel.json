{
  "rewrites": [
    {
      "source": "/api/followups/reminders",
      "destination": "/api/cron/follow-up-reminders"
    },
    { "source": "/api/leads/detail", "destination": "/api/leads?_route=detail" },
    { "source": "/api/leads/distribute", "destination": "/api/leads?_route=distribute" },
    { "source": "/api/leads/distribution-config", "destination": "/api/leads?_route=distribution-config" },
    { "source": "/api/leads/telecaller", "destination": "/api/leads?_route=telecaller-list" },
    { "source": "/api/leads/telecaller/update", "destination": "/api/leads?_route=telecaller-update" },
    { "source": "/api/billing/plans", "destination": "/api/billing?_route=plans" },
    { "source": "/api/billing/checkout", "destination": "/api/billing?_route=checkout" },
    { "source": "/api/billing/verify", "destination": "/api/billing?_route=verify" },
    { "source": "/api/billing/webhook", "destination": "/api/billing?_route=webhook" },
    { "source": "/api/billing/subscription", "destination": "/api/billing?_route=subscription" },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';"
        }
      ]
    }
  ]
}
