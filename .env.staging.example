# ENCRIX staging variable names only. Populate values in the Vercel Staging
# environment scope. Never copy production values into this file or staging.

# Public frontend build variables (safe to expose; anon key relies on RLS)
VITE_APP_ENV=staging
VITE_ENABLE_DEMO_SANDBOX=false
VITE_USE_LIVE_API=true
VITE_APP_URL=https://your-staging-host.example
VITE_TELEPHONY_PROVIDER=mock
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key

# Server-only Supabase and custom authentication secrets
SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
APP_URL=https://your-staging-host.example
OTP_SERVER_SECRET=replace-with-staging-only-random-secret
SESSION_SERVER_SECRET=replace-with-a-distinct-staging-only-random-secret

# Email OTP, invitation and optional follow-up reminder delivery
# Use a verified staging sender domain and controlled test inboxes.
RESEND_API_KEY=your-staging-resend-api-key
RESEND_FROM_EMAIL=ENCRIX Staging <auth@yourverifiedstagingdomain.example>
# Optional OTP fallback only; invitations and reminder emails use Resend.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ENABLE_FOLLOWUP_EMAIL_REMINDERS=false
FOUNDING_PILOT_GRANTS_ENABLED=false

# Razorpay Test Mode only; set the provider plan to Business ₹9,999/year, INR.
RAZORPAY_KEY_ID=rzp_test_replace-with-test-key-id
RAZORPAY_KEY_SECRET=replace-with-matching-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-staging-webhook-secret
RAZORPAY_PLAN_BUSINESS=replace-with-test-business-plan-id
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12

# Customer-owned Twilio voice accounts are configured per organization and
# stored encrypted. This key ring encrypts those credentials at rest.
# Supply canonical Base64-encoded 32-byte key values through Vercel only.
TWILIO_CREDENTIAL_ENCRYPTION_KEYS=
TWILIO_CREDENTIALS_ACTIVE_KEY_ID=
TWILIO_CALLING_ENABLED=false
TWILIO_PUBLIC_WEBHOOK_BASE_URL=https://your-staging-host.example
# Optional full callback URL overrides; leave empty to derive from the public base.
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=

# Optional platform Twilio SMS credentials for phone enrollment OTP.
# These are separate from customer-owned voice credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Backwards-compatible phone variable if the code path requires it.
TWILIO_CALLER_ID=

# Scheduled follow-up endpoint secret (server-only; never a VITE_ variable).
CRON_SECRET=replace-with-staging-only-random-secret-at-least-32-characters
