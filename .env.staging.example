# ==============================================================================
# ENCRIX CRM - Dedicated Staging Environment Configuration Template
# Copy this file to .env.staging and populate with your dedicated staging credentials.
# CRITICAL: DO NOT POINT THIS TO YOUR PRODUCTION SUPABASE PROJECT (wrzoqxesffbfirjgotbr)!
# ==============================================================================

# Client runtime mode
VITE_APP_ENV=staging

# Disable offline mock/demo sandbox in staging
VITE_ENABLE_DEMO_SANDBOX=false

# Dedicated Staging Supabase Project
# Obtain these from: Supabase Dashboard > ENCRIX-Staging > Settings > API
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-supabase-anon-key

# Serverless API Secrets (Server runtime only - DO NOT prefix with VITE_)
SUPABASE_URL=https://your-staging-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-staging-supabase-service-role-key

# Staging Session & OTP Secrets (Use distinct random 32+ byte strings)
JWT_SECRET=your-staging-jwt-secret-min-32-chars
OTP_SERVER_SECRET=your-staging-otp-server-secret-min-32-chars
SESSION_SERVER_SECRET=your-staging-session-server-secret-min-32-chars

# Email Provider Integration (Resend)
RESEND_API_KEY=re_your_staging_resend_api_key
RESEND_FROM_EMAIL=ENCRIX Staging <auth@yourverifieddomain.com>

# Telephony Integration (Twilio Test Account or Dedicated Staging Subaccount)
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-staging-twilio-account-sid
TWILIO_AUTH_TOKEN=your-staging-twilio-auth-token
TWILIO_CALLER_ID=+15551234567
TWILIO_VOICE_WEBHOOK_URL=https://your-staging-deployment.vercel.app/api/telephony/voice
TWILIO_STATUS_CALLBACK_URL=https://your-staging-deployment.vercel.app/api/telephony/webhook
