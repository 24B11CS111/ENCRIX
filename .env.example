# LEADVAULT CRM - Environment Configuration
# Copy this file to .env and fill in your values

# Supabase Public Keys (Client-Safe)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Keys (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Telephony Gateway Integration (Server-Side / Provider credentials)
TELEPHONY_PROVIDER=mock # Options: mock, twilio, exotel, knowlarity
TELEPHONY_API_KEY=your-telephony-api-key
TELEPHONY_API_SECRET=your-telephony-api-secret

# LeadVault Feature Flags
# If true, enables offline enterprise demo sandbox with preloaded Vertex Consultancy data
VITE_ENABLE_DEMO_SANDBOX=true
