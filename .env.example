# ==============================================================================
# LEADVAULT CRM - Environment Configuration Specification
# Copy this file to .env (or .env.staging / .env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Bundled into frontend browser/mobile)
# ------------------------------------------------------------------------------
# Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development

# Feature Flag: If true, enables offline enterprise demo sandbox (Dev only!)
# MUST BE false IN STAGING AND PRODUCTION!
VITE_ENABLE_DEMO_SANDBOX=true

# Public Supabase API Endpoint & Anon/Public Key (Row Level Security protected)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO FRONTEND OR BUNDLE WITH VITE_)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (Bypasses RLS - backend migrations & system tasks ONLY)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Telephony Gateway Integration
# Provider options: 'mock' (Dev) | 'twilio' (Staging/Prod) | 'exotel'
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_CALLER_ID=+15551234567
TWILIO_VOICE_WEBHOOK_URL=https://your-domain.com/api/telephony/voice

# ------------------------------------------------------------------------------
# 3. EMAIL OTP AUTHENTICATION (SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address (Or "onboarding@resend.dev" for testing prior to custom domain verification)
RESEND_FROM_EMAIL=ENCRIX Security <auth@encrix.io>

# Server HMAC secret used to hash OTP codes; replace with a random value of at least 32 bytes.
# Never expose server secrets to browser code or logs.
OTP_SERVER_SECRET=your-cryptographic-server-secret-salt-here
# Server HMAC secret used to sign and verify session tokens; use a distinct random value of at least 32 bytes.
SESSION_SERVER_SECRET=your-cryptographic-session-secret-here

# ------------------------------------------------------------------------------
# 4. FOLLOW-UP REMINDER CRON ENGINE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Authorization secret required to trigger scheduled reminder/escalation jobs
CRON_SECRET=your-cryptographic-cron-secret-here

# Feature flag: Enable optional email notifications alongside in-app reminders
ENABLE_FOLLOWUP_EMAIL_REMINDERS=false

# Optional Client Flag: Forces frontend to dispatch to /api/auth/* routes during local live testing
# VITE_USE_LIVE_API=true
