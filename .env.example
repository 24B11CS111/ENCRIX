# ==============================================================================
# ENCRIX CRM - Environment Configuration Specification
# Copy this file to .env (or .env.staging / .env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Bundled into frontend browser/mobile)
# ------------------------------------------------------------------------------
# Environment: 'development' | 'staging' | 'production'
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_TELEPHONY_PROVIDER=mock

# Feature Flag: If true, enables offline enterprise demo sandbox (Dev only!)
# MUST BE false IN STAGING AND PRODUCTION!
VITE_ENABLE_DEMO_SANDBOX=true

# Public Supabase API Endpoint & Anon/Public Key (Row Level Security protected)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER EXPOSE TO FRONTEND OR BUNDLE WITH VITE_)
# ------------------------------------------------------------------------------
# Server-only Supabase project URL and service key. The service key bypasses RLS;
# use it only in server routes after explicit identity, role and tenant checks.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Canonical public HTTPS origin used for invitation links and server callbacks.
APP_URL=https://your-domain.example

# Twilio multi-tenant calling configuration. Customer Account SID/Auth Token
# are entered by an organization owner and stored encrypted in Supabase.
# Use one or more distinct 32-byte base64 AES keys in the server keyring.
TWILIO_CREDENTIAL_ENCRYPTION_KEYS=
TWILIO_CREDENTIALS_ACTIVE_KEY_ID=
# Keep false until migrations, callback URLs and sandbox checks pass.
TWILIO_CALLING_ENABLED=false
# Must be the public HTTPS origin of this deployment.
TWILIO_PUBLIC_WEBHOOK_BASE_URL=https://your-domain.example
# Optional callback overrides; otherwise derived from APP_URL / public base.
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
# Optional platform Twilio account for phone-enrollment SMS. Customer-owned
# voice credentials are configured per organization and stored encrypted.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 3. EMAIL OTP AUTHENTICATION (SERVER-SIDE ONLY - NEVER PREFIX WITH VITE_)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address (Or "onboarding@resend.dev" for testing prior to custom domain verification)
RESEND_FROM_EMAIL=ENCRIX Security <auth@encrix.io>
# Optional OTP delivery fallback (server-only).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Server HMAC secret used to hash OTP codes; replace with a random value of at least 32 bytes.
# Never expose server secrets to browser code or logs.
OTP_SERVER_SECRET=your-cryptographic-server-secret-salt-here
# Server HMAC secret used to sign and verify session tokens; use a distinct random value of at least 32 bytes.
SESSION_SERVER_SECRET=your-cryptographic-session-secret-here

# Paid entitlement checks are always enforced by server routes and the database.
# No environment flag can bypass subscription verification.
FOUNDING_PILOT_GRANTS_ENABLED=false

# Razorpay Test Mode only; keep these server-side and never prefix them with VITE_.
# Current catalog is one Business subscription: ₹9,999 INR per year, with no
# onboarding or registration fee. Test checkout remains unavailable unless the
# exact Test Mode plan, server credentials and billing database all validate.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BUSINESS=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=

# ------------------------------------------------------------------------------
# 4. FOLLOW-UP REMINDER CRON ENGINE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Authorization secret required to trigger scheduled reminder/escalation jobs
CRON_SECRET=your-cryptographic-cron-secret-here

# Feature flag: Enable optional email notifications alongside in-app reminders
ENABLE_FOLLOWUP_EMAIL_REMINDERS=false

# Optional Client Flag: Forces frontend to dispatch to /api/auth/* routes during local live testing
# VITE_USE_LIVE_API=true
